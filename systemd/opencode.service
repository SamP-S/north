[Unit]
Description=Opencode agent runtime server
After=network.target
OnFailure=north-notify-failure@%n.service
# give up after 3 failed starts in 60s instead of looping (and notifying) forever
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment=OPENCODE_PORT=4096
ExecStart=%h/.opencode/bin/opencode serve --hostname 127.0.0.1 --port ${OPENCODE_PORT}
EnvironmentFile=-%h/.north/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

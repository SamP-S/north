[Unit]
Description=North board state service
After=network.target
# give up after 3 failed starts in 60s instead of looping forever
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment=NORTH_PORT=8001
ExecStart=%h/.local/bin/uv run uvicorn north.service.main:app --host 127.0.0.1 --port ${NORTH_PORT} --timeout-keep-alive 30
WorkingDirectory=@@WORKING_DIR@@
EnvironmentFile=-@@WORKING_DIR@@/.env
EnvironmentFile=-%h/.north/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

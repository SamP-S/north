[Unit]
Description=Aurora agentic dev service
After=network.target
OnFailure=north-notify-failure@%n.service
# give up after 3 failed starts in 60s instead of looping (and notifying) forever
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
Environment=AURORA_PORT=8000
ExecStart=%h/.local/bin/uv run --package aurora uvicorn aurora.service.main:app --host 127.0.0.1 --port ${AURORA_PORT}
WorkingDirectory=@@WORKING_DIR@@
EnvironmentFile=-@@WORKING_DIR@@/.env
EnvironmentFile=-%h/.north/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
